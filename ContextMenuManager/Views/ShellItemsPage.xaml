<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContextMenuManager.Views.ShellItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ContextMenuManager.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,10,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="CountText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <AutoSuggestBox
                x:Name="SearchBox"
                x:Uid="SearchBox"
                Grid.Column="1"
                VerticalAlignment="Center"
                QueryIcon="Find"
                TextChanged="OnSearchChanged" />

            <Button
                x:Name="RefreshButton"
                x:Uid="RefreshButton"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Click="OnRefresh">
                <FontIcon Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <ListView
            x:Name="ItemsList"
            Grid.Row="1"
            SelectionMode="None"
            IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ShellEntry">
                    <Grid ColumnSpacing="8" Padding="12,8,12,8" ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="24" Height="24"
                            VerticalAlignment="Center"
                            Source="{x:Bind IconSource, Mode=OneWay}" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    Glyph="&#xE70D;"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind HasSubItemsVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind Tooltip, Mode=OneWay}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <CheckBox
                            x:Uid="VisibleToggle"
                            Grid.Column="2"
                            MinWidth="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsChecked="{x:Bind Visible, Mode=TwoWay}"
                            Checked="OnToggleChanged"
                            Unchecked="OnToggleChanged" />

                        <Button
                            x:Uid="MoreButton"
                            Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind EditMenuVisibility, Mode=OneWay}">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="MenuRename" Click="OnRename">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8AC;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="MenuChangeCommand" Click="OnChangeCommand">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE756;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Uid="MenuChangeIcon" Click="OnChangeIcon">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE890;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="MenuRemoveIcon" Click="OnRemoveIcon">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <ToggleMenuFlyoutItem
                                        x:Uid="MenuShieldIcon"
                                        IsChecked="{x:Bind HasShield, Mode=OneWay}"
                                        Click="OnToggleShield" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutSubItem x:Uid="MenuPosition">
                                        <RadioMenuFlyoutItem
                                            x:Uid="MenuPosDefault"
                                            GroupName="Position"
                                            IsChecked="{x:Bind IsPositionDefault, Mode=OneWay}"
                                            Click="OnSetPositionDefault" />
                                        <RadioMenuFlyoutItem
                                            x:Uid="MenuPosTop"
                                            GroupName="Position"
                                            IsChecked="{x:Bind IsPositionTop, Mode=OneWay}"
                                            Click="OnSetPositionTop" />
                                        <RadioMenuFlyoutItem
                                            x:Uid="MenuPosBottom"
                                            GroupName="Position"
                                            IsChecked="{x:Bind IsPositionBottom, Mode=OneWay}"
                                            Click="OnSetPositionBottom" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem x:Uid="MenuAttributes">
                                        <ToggleMenuFlyoutItem
                                            x:Uid="MenuOnlyShift"
                                            IsChecked="{x:Bind OnlyWithShift, Mode=OneWay}"
                                            Click="OnToggleOnlyShift" />
                                        <ToggleMenuFlyoutItem
                                            x:Uid="MenuOnlyExplorer"
                                            IsChecked="{x:Bind OnlyInExplorer, Mode=OneWay}"
                                            Click="OnToggleOnlyExplorer" />
                                        <ToggleMenuFlyoutItem
                                            x:Uid="MenuNoWorkDir"
                                            IsChecked="{x:Bind NoWorkingDirectory, Mode=OneWay}"
                                            Click="OnToggleNoWorkDir" />
                                        <ToggleMenuFlyoutItem
                                            x:Uid="MenuNeverDefault"
                                            IsChecked="{x:Bind NeverDefault, Mode=OneWay}"
                                            Click="OnToggleNeverDefault" />
                                    </MenuFlyoutSubItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            x:Uid="DeleteButton"
                            Grid.Column="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Click="OnDelete">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="1"
            Width="40" Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False" />
    </Grid>
</Page>
